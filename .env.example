# Copy this to .env and fill in real values. .env is gitignored -- never
# commit real credentials. See README.md for where to get each one.

# --- Bright Data (https://brightdata.com -> Scraper APIs) ---
# One account, one API token, shared across all three scraper datasets
# below -- each is a separate Bright Data "Scraper API" product, so each
# gets its own dataset id even though auth is unified.
BRIGHTDATA_API_KEY=
# Reddit Scraper API dataset id (fed keyword searches from scraper/search_terms.py)
BRIGHTDATA_REDDIT_DATASET_ID=
# TikTok Scraper API dataset id (fed keyword/hashtag searches per category)
BRIGHTDATA_TIKTOK_DATASET_ID=
# Instagram Scraper API dataset id (fed keyword searches per category, reels only)
BRIGHTDATA_INSTAGRAM_DATASET_ID=

# --- YouTube OAuth (uploads -- separate from the Bright Data YouTube scraper) ---
# Google Cloud project -> Credentials -> OAuth client ID -> type "Web
# application", with YT_OAUTH_REDIRECT_URI added as an authorized redirect URI.
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=
YT_OAUTH_REDIRECT_URI=http://localhost:8080/youtube/oauth2callback

# --- Dashboard login ---
DASHBOARD_USERNAME=admin
# Generate with: python gen_password_hash.py
DASHBOARD_PASSWORD_HASH=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- analyzer (freeform vision+audio tagging -- see analyzer/ and README) ---
# Local model via Ollama -- `curl -fsSL https://ollama.com/install.sh | sh`
# then `ollama pull llava:7b` (or whatever OLLAMA_VISION_MODEL you set).
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_VISION_MODEL=llava:7b
# WHISPER_MODEL_SIZE=small
# ANALYZER_TIMEOUT_SEC=180
# ANALYZER_MAX_FRAMES=16
# ANALYZER_MAX_TAGS=12
# FRAME_SAMPLE_REST_SEC=0.5
# FRAME_SAMPLE_MOTION_SEC=0.25
# FRAME_DIFF_THRESHOLD=12.0

# --- Bright Data credit cap -------------------------------------------------
# Two levers, both applied by default (Bright Data bills per RECORD
# DELIVERED, not per keyword or per API call -- see scraper/brightdata_client.py):
#   SEARCH_TERMS_PER_RUN=2         terms each platform searches per hourly
#                                  run, walking the unified list round-robin
#                                  (6 searches/hour total across 3 platforms;
#                                  the full list still gets covered over
#                                  successive runs)
#   BRIGHTDATA_LIMIT_PER_INPUT=1   records Bright Data returns per keyword
#                                  (the trigger endpoint's own limit_per_input)
# At the defaults: 2 x 3 platforms x 1 record x 24 runs/day x 30 days =
# ~4,320 credits/month -- between the 3,000/month target and Bright Data's
# 5,000/month free-tier ceiling. Raise either for more coverage/data at
# proportionally higher cost.
# SEARCH_TERMS_PER_RUN=2
# BRIGHTDATA_LIMIT_PER_INPUT=1

# --- adaptive search parameters / engagement scoring / autonomy ------------
# ADAPTIVE_VOTE_THRESHOLD=3
# ENGAGEMENT_WEIGHT_LIKES=0.5
# ENGAGEMENT_WEIGHT_COMMENTS=0.3
# ENGAGEMENT_WEIGHT_SHARES=0.2
# AUTO_COMPILATION_MIN_SEC=60
# AUTO_COMPILATION_MAX_SEC=90
# DEFAULT_AUTONOMY_LEVEL=manual   # manual | assisted | autonomous -- see autonomy.py, overridable from /settings

# --- weekly feedback loop (scraper/weekly_review.py, /weekly-review) -------
# WEEKLY_REVIEW_BATCH_MIN=12
# WEEKLY_REVIEW_BATCH_MAX=24
# WEEKLY_REVIEW_TOP_PICK_COUNT=12
# WEEKLY_REVIEW_VOTE_WEIGHT=3          # an ordinary weekly-review vote, vs. weight 1 for a routine /triage vote
# WEEKLY_REVIEW_DIVERGENCE_WEIGHT=6    # voting down a clip the bot marked as a top pick -- the strongest signal
# FEEDBACK_SCORE_WEIGHT=0.5            # how much clips.feedback_score (weighted votes) shifts engagement_score

# --- tunables (defaults shown; uncomment to override) ---
# BRIGHTDATA_POLL_INTERVAL_SEC=5     # seconds between snapshot-status polls
# BRIGHTDATA_POLL_TIMEOUT_SEC=300    # give up waiting on a collection after this long
# DEDUP_WINDOW_HOURS=24
# MAX_CLIP_DURATION_SEC=15
# MIN_CLIP_DURATION_SEC=3
# REDDIT_LISTING_LIMIT=15
# FFMPEG_CRF=25
# FFMPEG_PRESET=veryfast
# REDDIT_USER_AGENT=Mozilla/5.0 (compatible; meme-pipeline/1.0; +https://github.com/blackwilliamt-svg/Youtubebot)
# OUTPUT_WIDTH=720
# OUTPUT_HEIGHT=1280
# MAX_COMPILATION_SEC=58
# TRANSITION_SEC=0.4
# SLIDE_DURATION_SEC=2.5       # how long an image/gif renders as a video slide
# MUSIC_DUCK_VOLUME=0.25       # library/music/ level under silent segments
# MAX_IMAGE_DOWNLOAD_BYTES=20971520
# MAX_GIF_DOWNLOAD_BYTES=41943040
# MAX_UPLOAD_BYTES=524288000     # cap on the /review "upload your own footage" file picker
# MAX_THUMBNAIL_BYTES=2097152    # YouTube's own custom-thumbnail size limit
# SNAPSHOT_CATEGORY_DELAY_SEC=5  # pacing between categories in the manual test-snapshot button
# LOG_LEVEL=INFO
