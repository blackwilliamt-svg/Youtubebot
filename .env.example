# Copy this to .env and fill in real values. .env is gitignored -- never
# commit real credentials. See README.md for where to get each one.

# --- Reddit (script/read-only OAuth app: https://www.reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=meme-pipeline/1.0 (by u/your_username)

# --- YouTube Data API (search/trending reads) ---
# https://console.cloud.google.com/apis/credentials -> API key, restrict
# to "YouTube Data API v3".
YOUTUBE_API_KEY=

# --- YouTube OAuth (uploads) ---
# Same Google Cloud project -> OAuth client ID, type "Web application",
# with YT_OAUTH_REDIRECT_URI added as an authorized redirect URI.
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=
YT_OAUTH_REDIRECT_URI=http://localhost:8080/youtube/oauth2callback

# --- Vimeo (https://developer.vimeo.com/apps -> generate an access token
# with the default "public" scope) ---
VIMEO_ACCESS_TOKEN=

# --- Dashboard login ---
DASHBOARD_USERNAME=admin
# Generate with: python gen_password_hash.py
DASHBOARD_PASSWORD_HASH=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- tunables (defaults shown; uncomment to override) ---
# DEDUP_WINDOW_HOURS=24
# MAX_CLIP_DURATION_SEC=120
# MIN_CLIP_DURATION_SEC=3
# REDDIT_LISTING_LIMIT=15
# FFMPEG_CRF=25
# FFMPEG_PRESET=veryfast
# OUTPUT_WIDTH=720
# OUTPUT_HEIGHT=1280
# MAX_COMPILATION_SEC=58
# TRANSITION_SEC=0.4
# SLIDE_DURATION_SEC=2.5       # how long an image/gif renders as a video slide
# MUSIC_DUCK_VOLUME=0.25       # library/music/ level under silent segments
# MAX_IMAGE_DOWNLOAD_BYTES=20971520
# MAX_GIF_DOWNLOAD_BYTES=41943040
# SNAPSHOT_CATEGORY_DELAY_SEC=5  # pacing between categories in the manual test-snapshot button
# LOG_LEVEL=INFO
