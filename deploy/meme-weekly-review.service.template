[Unit]
Description=meme-pipeline weekly feedback-loop batch build (see scraper/weekly_review.py)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/python -m scraper.run_weekly_review
MemoryMax=700M
TimeoutStartSec=300
