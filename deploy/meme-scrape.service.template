[Unit]
Description=meme-pipeline hourly scrape
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/python -m scraper.run_hourly
# Guardrails for a 2GB box -- one bad hour shouldn't take the droplet down.
MemoryMax=1400M
TimeoutStartSec=1500
